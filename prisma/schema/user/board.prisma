enum BoardCategory {
  FREE
  KNOWHOW
  WINNING
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model Post {
  id               Int           @id @default(autoincrement())
  userId           String        @map("user_id")
  category         BoardCategory
  title            String        @db.VarChar(100)
  content          String        @db.Text
  imageUrl         String?       @map("image_url") @db.VarChar(500)
  originalFileName String?       @map("original_file_name") @db.VarChar(500)
  lottoRank        Int?          @map("lotto_rank")
  lottoRound       Int?          @map("lotto_round")
  lottoIdentifier  String?       @unique @map("lotto_identifier") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  isDeleted        Boolean       @default(false) @map("is_deleted")
  isBlocked        Boolean       @default(false) @map("is_blocked")
  isAdmin          Boolean       @default(false) @map("is_admin")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     PostReport[]
  comments    PostComment[]
  likes       PostLike[]
  attachments PostAttachment[]

  @@index([userId])
  @@map("post")
}

model PostReport {
  id         Int          @id @default(autoincrement())
  postId     Int          @map("post_id")
  userId     String       @map("user_id")
  reason     String       @db.Text
  answer     String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  answeredAt DateTime?    @map("answered_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("post_report")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  isBlocked Boolean  @default(false) @map("is_blocked")
  isAdmin   Boolean  @default(false) @map("is_admin")
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post    Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?    @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[]   @relation("CommentToComment")
  likes   CommentLike[]
  reports CommentReport[]

  @@index([postId])
  @@index([userId])
  @@map("post_comment")
}

model PostLike {
  postId    Int      @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_like")
}

model CommentLike {
  commentId Int      @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_like")
}

model CommentReport {
  id         Int          @id @default(autoincrement())
  commentId  Int          @map("comment_id")
  userId     String       @map("user_id")
  reason     String       @db.Text
  answer     String?      @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  answeredAt DateTime?    @map("answered_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
  @@map("comment_report")
}

model PostAttachment {
  id               Int      @id @default(autoincrement())
  postId           Int      @map("post_id")
  imageUrl         String   @map("image_url") @db.VarChar(1000)
  originalFileName String?  @map("original_file_name") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_attachment")
}
